# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenRouter API key used for all model calls (server-side only). Required.
OPENROUTER_API_KEY=

# Shared password for the login page. Required.
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Budget & debate tuning (all optional)
# ---------------------------------------------------------------------------

# Hard spending cap per quest, in USD. Default: 0.50
MAX_COST_USD_PER_QUEST=0.50

# Max web search results fed to agents per search. Integer count. Default: 3
# WEB_SEARCH_MAX_RESULTS=3

# Max characters of a peer agent message kept after sanitization. Default: 6000
# PEER_MESSAGE_MAX_CHARS=6000

# Exact-match SQLite cache for web-search-backed agent calls. Default: true
# TOOL_CACHE_ENABLED=true

# Lifetime of cached tool results, in hours. Default: 24
# TOOL_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Storage (optional)
# ---------------------------------------------------------------------------

# SQLite database file path. Default: ./data/council.db
# DATABASE_PATH=./data/council.db

# ---------------------------------------------------------------------------
# Auth & sessions (optional)
# ---------------------------------------------------------------------------

# Session lifetime, in hours. Default: 168 (7 days)
# SESSION_TTL_HOURS=168

# Only the exact value "true" forces the Secure cookie flag. Leave unset when
# serving over plain http (LAN/VPN); https requests are marked Secure automatically.
# COOKIE_SECURE=

# Failed login attempts allowed per window before lockout. Default: 5
# LOGIN_MAX_ATTEMPTS=5

# Login rate-limit window, in minutes. Default: 15
# LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Attachments (optional)
# ---------------------------------------------------------------------------

# Directory for uploaded files. Default: "uploads" next to the SQLite DB (./data/uploads)
# UPLOADS_DIR=./data/uploads

# Max size of a single uploaded file, in MB. Default: 10
# MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Multimodal (optional)
# ---------------------------------------------------------------------------

# OpenRouter PDF engine for file-parser plugin: pdf-text (free, default) | mistral-ocr | native
# PDF_ENGINE=pdf-text

# Max total characters of text-file attachments inlined into agent prompts. Default: 20000
# ATTACHMENT_TEXT_MAX_CHARS=20000

# ---------------------------------------------------------------------------
# Cross-quest memory (optional)
# ---------------------------------------------------------------------------

# Master switch. false disables storing and recall (existing rows stay viewable/deletable). Default: true
# MEMORY_ENABLED=true

# Cheap model for memory extraction/merge calls. Default: google/gemini-2.5-flash
# MEMORY_MODEL=google/gemini-2.5-flash

# OpenRouter embedding model. Default: openai/text-embedding-3-small
# MEMORY_EMBED_MODEL=openai/text-embedding-3-small

# Max memories recalled per quest. Default: 5
# MEMORY_RECALL_K=5

# Max total characters of recalled memory injected into prompts. Default: 1200
# MEMORY_MAX_INJECT_CHARS=1200

# Max stored memories before the oldest, lowest-confidence unpinned rows are pruned
# (hard ceiling 5000). Default: 2000
# MEMORY_MAX_ROWS=2000

# Max USD the post-quest memory extraction call may cost; above it the result is
# discarded. Extraction is also skipped when the quest already hit its cost cap. Default: 0.01
# MEMORY_EXTRACT_MAX_COST_USD=0.01
